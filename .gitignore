# --- Porchlight ---
.env
*.db
*.sqlite
*.sqlite3
chroma*/
out/
alerts.log

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Obsidian ---
# Editor config, like .vscode/. The notes themselves are tracked; the
# workspace layout and plugin settings are not.
.obsidian/

# --- OS ---
Thumbs.db
.DS_Store

# Personal scratch notes, kept local
Notes.md
promtpot.md
terminal color.md

# Video production material: recorded narration, sound effects pulled from
# elsewhere, and the rendered YouTube thumbnail. None of it is source, and
# the sound effects are not ours to redistribute.
voices/
porchlight-thumbnail.png

# Video reference clips and scratch frame exports. Reference material only —
# 52MB of third-party footage that must never enter the repo, and MOTION_REFS.md
# says to delete it before submission. A `git add -A` swept these in once.
refs/
*.mp4

# Hackathon paperwork, kept local. REQUIREMENTS.md is Devpost's and AWS's
# own rules text, not ours to redistribute; HACKATHON.md is the working
# summary of it.
REQUIREMENTS.md
HACKATHON.md

# Frozen copy of the run-4 state — database, vector store, rendered page and
# alert log — kept so the demo run can be restored if a later run overwrites
# it. Local safety net, not source. The pieces inside are already ignored by
# the patterns above; this covers the directory itself.
.freeze/

# Design-tool working state: build state, review screenshots, captured frames.
# Scratch, regenerated on demand.
.impeccable/

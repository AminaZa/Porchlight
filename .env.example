# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Provider ---------------------------------------------------------------
# "bedrock" (default) or "anthropic"
FNA_PROVIDER=bedrock
AWS_REGION=us-east-1

# --- Model IDs per role -----------------------------------------------------
# VERIFY THESE BEFORE FIRST RUN. Bedrock uses inference-profile IDs, not the
# bare model names. Run:
#
#     aws bedrock list-inference-profiles --region $AWS_REGION
#
# and paste what's actually there. A guessed ID fails at the first call.
# Model access must also be granted in the Bedrock console for all three.
FNA_MODEL_TRIAGE=
FNA_MODEL_CORRELATION=
FNA_MODEL_ESCALATION=

# --- Only needed when FNA_PROVIDER=anthropic --------------------------------
# Requires: pip install 'strands-agents[anthropic]'
ANTHROPIC_API_KEY=

# --- Behavior ---------------------------------------------------------------
# 1 = send_alert blocks for human approval before dispatch.
# Leave unset for the demo; set to 1 for any real deployment.
FNA_REQUIRE_APPROVAL=

# 1 = emit OpenTelemetry spans to the console. Off keeps demo output clean.
FNA_TRACE=

# Days to retain raw report text before it is deleted (aggregates survive).
FNA_RETENTION_DAYS=90

# --- Storage paths ----------------------------------------------------------
FNA_DB_PATH=porchlight.db
FNA_CHROMA_PATH=chroma

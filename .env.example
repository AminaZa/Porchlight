# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Provider ---------------------------------------------------------------
# "bedrock" (default) or "anthropic"
FNA_PROVIDER=bedrock
AWS_REGION=us-east-1

# --- Model IDs per role -----------------------------------------------------
# Leave blank to use the defaults in src/provider.py, which were verified
# against a live account in us-east-1 on 2026-08-31. To check your own:
#
#     python -m src.provider --list
#
# Bedrock uses inference-profile IDs, not bare model names, and availability is
# per-region. Note Haiku 4.5 is only published as a dated, versioned profile.
# There is no longer a model-access page to tick: serverless models auto-enable
# on first invocation, though a brand-new account is blocked by AWS account
# verification for up to a couple of hours first.
FNA_MODEL_TRIAGE=global.anthropic.claude-haiku-4-5-20251001-v1:0
FNA_MODEL_CORRELATION=global.anthropic.claude-sonnet-5
FNA_MODEL_ESCALATION=global.anthropic.claude-opus-5

# --- Only needed when FNA_PROVIDER=anthropic --------------------------------
# Requires: pip install 'strands-agents[anthropic]'
ANTHROPIC_API_KEY=

# --- Behavior ---------------------------------------------------------------
# 1 = send_alert blocks for human approval before dispatch.
# Leave unset for the demo; set to 1 for any real deployment.
FNA_REQUIRE_APPROVAL=

# 1 = emit OpenTelemetry spans to the console. Off keeps demo output clean.
# If OTEL_EXPORTER_OTLP_ENDPOINT is also set, spans go there instead.
FNA_TRACE=

# How many times the redaction guard lets the model retry before failing the
# report. See src/guards.py. Raising this spends more; lowering it to 0 turns
# a retry into an immediate failure.
FNA_GUARD_RETRIES=2

# Days to retain raw report text before it is deleted (aggregates survive).
FNA_RETENTION_DAYS=90

# --- Storage paths ----------------------------------------------------------
FNA_DB_PATH=porchlight.db
FNA_CHROMA_PATH=chroma
